# Privilege-separated sysctl mutation helper for the SystemAPI agent
# (docs/sah-os-management-design.md, "Finding 2026-10-23" + mutation-helper
# section, option 2). Security-keystone spike for the ONE verb
# sys:tweak sysctl-set.
#
# WHY THIS UNIT EXISTS
# The agent runs under a sandbox with ProtectKernelTunables=yes, which makes
# /proc/sys read-only, so the agent cannot write a sysctl itself. Instead of
# widening the agent's own sandbox (which would hand every agent code path the
# power to write kernel tunables), the write is handed to THIS minimally-scoped,
# one-shot helper. Its sandbox is the agent's hardening MINUS exactly one knob
# (ProtectKernelTunables) and nothing else. The confinement lives here, in a
# committed unit; the agent never constructs it at runtime. The agent only
# triggers the instance and passes a request id as %i.
#
# TRIGGER (the unverified assumption this spike tests)
# The agent starts an instance of this template over systemd's manager (the same
# StartUnit/job-wait access it uses to restart a service), e.g.
#   systemctl start sah-sysctl-helper@<id>.service
# whether the agent, under NoNewPrivileges and a restricted capability set, is
# actually PERMITTED to StartUnit this privileged unit over D-Bus can only be
# confirmed on a real host. That is the point of the spike.
#
# HANDOFF
# The agent writes /var/lib/systemapi-agent/sysctl-helper/<id>.req (0600, that it
# owns), the helper reads it, re-validates the key/value independently, writes
# /proc/sys, and writes /var/lib/systemapi-agent/sysctl-helper/<id>.res back. One
# request per invocation; the agent cleans both files up.
#
# %i is always a 32-char hex id minted by the agent (sysctlHelperIDRE), so there
# is no systemd instance-name escaping to reason about.
#
# WIRING (follow-up, NOT in this repo): deploy/miniapps1/agent/install-agent.sh
# (on another branch) must install this file to /etc/systemd/system/ and run
# `systemctl daemon-reload`. It must also reconcile the ExecStart path and the
# hardening set below with the agent's own hardened unit, so this helper is
# provably "the agent's sandbox minus ProtectKernelTunables".

# LEASE CHECK (helper_auth.go). The helper re-verifies the signed lease the
# agent passes in the request against the control-plane key in
# /etc/systemapi-agent/helper-trust.json, and consumes its nonce in
# /var/lib/sah-helper/consumed (StateDirectory below), which the agent's own
# sandbox cannot write. Provision the trust file once, as root, after the agent
# has enrolled, with scripts/provision-helper-trust.sh. The control-plane key
# MUST be the out-of-band pinned value from the install bundle (or read by the
# operator from the control plane), never copied from agent.json, which the
# agent can write; the script cross-checks it against agent.json and refuses
# on a mismatch, refuses symlinks, and writes 0644 root:root atomically:
#   scripts/provision-helper-trust.sh --pubkey <pinned base64 key> --host-id <pinned id>
# Without it every helper write fails closed with trust_unavailable.
#
# LIMITS (security review finding 1, an open owner design decision). "The
# agent's sandbox cannot write" /etc, /proc/sys or the replay store holds only
# for the agent's OWN file operations. The agent runs as root and can talk to
# systemd's manager over D-Bus (that is how it starts this unit), and PID 1 is
# outside every sandbox: a compromised agent can start or create a unit with
# no sandbox at all (for example a transient unit via StartTransientUnit /
# systemd-run) and write anything as unconfined root, bypassing this helper
# and its lease check entirely. So while the agent is root with systemd bus
# access, this helper is NOT a security boundary against a compromised agent.
# It confines bugs and an attacker limited to the agent's request files, and it
# keeps every legitimate write lease-checked; it does not contain the agent.

[Unit]
Description=SystemAPI sysctl mutation helper (%i)
Documentation=file:///usr/share/doc/systemapi/sah-os-management-design.md

[Service]
Type=oneshot
# Only the request id is passed. The confinement is this unit, never an argument.
ExecStart=/usr/local/lib/systemapi-agent/systemapi-agent __sysctl-helper %i

# Root, because writing /proc/sys is privileged. The capability bounding set
# below is the real limiter.
User=root
UMask=0077
# The durable replay store (helper_auth.go), shared by every helper and
# never in the agent's ReadWritePaths.
StateDirectory=sah-helper
StateDirectoryMode=0700

# A kernel write must not hang the manager; bound the whole invocation.
# RuntimeMaxSec= is ignored for Type=oneshot; the start timeout bounds it.
TimeoutStartSec=10

# --- Sandbox: the agent's hardening MINUS ProtectKernelTunables ---

# THE ONE RELAXATION vs the agent. =yes on the agent makes /proc/sys read-only;
# =no here, and only here, lets this helper write a sysctl. Nothing else is
# loosened.
ProtectKernelTunables=no

NoNewPrivileges=yes
# ProtectSystem=strict mounts the whole hierarchy read-only except /dev /proc
# /sys; /proc/sys writability is governed by ProtectKernelTunables above, not by
# this. The handoff dir is the only non-/proc path the helper may write.
ProtectSystem=strict
ReadWritePaths=/var/lib/systemapi-agent/sysctl-helper /var/lib/sah-helper
ProtectHome=yes
PrivateTmp=yes

# No network. The helper only writes /proc/sys; it opens no socket.
# NOTE: PrivateNetwork is deliberately NOT set. net.* sysctls live in the host
# network namespace, and a private netns would silently write that namespace's
# knobs instead of the host's. Socket use is denied directly instead.
RestrictAddressFamilies=none
IPAddressDeny=any

# Kernel/host protections kept from the agent's sandbox.
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# ProtectProc hides other processes; ProcSubset is left at the default (all)
# ON PURPOSE, because ProcSubset=pid would hide /proc/sys and break the write.
ProtectProc=invisible

# The granted sysctl keys decide which of these is actually needed: net.* needs
# CAP_NET_ADMIN, kernel/vm/fs.* needs CAP_SYS_ADMIN. This is the superset for
# v1; tightening per-key is a follow-up once the policy key set is fixed.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN
AmbientCapabilities=

SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# Deliberately no [Install] section: this template is started on demand by the
# agent, never enabled or wanted by a boot target.
