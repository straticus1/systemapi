# DNS Science Unbound Configuration
# Generated by systemapi-agent sysscript — {{ .generated_at }}
server:
    verbosity: {{ default "1" .verbosity }}
    num-threads: {{ default "2" .num_threads }}
    interface: {{ default "0.0.0.0" .interface }}
    port: {{ default "53" .port }}
    do-ip4: {{ default "yes" .do_ip4 }}
    do-ip6: {{ default "yes" .do_ip6 }}
    do-udp: {{ default "yes" .do_udp }}
    do-tcp: {{ default "yes" .do_tcp }}

    # Access control
    {{ range .access_control }}access-control: {{ . }}
    {{ else }}access-control: 0.0.0.0/0 allow
    access-control: ::0/0 allow
    {{ end }}
    # Logging
    logfile: "{{ default "/var/log/unbound/unbound.log" .logfile }}"
    log-queries: {{ default "yes" .log_queries }}
    log-replies: {{ default "yes" .log_replies }}
    log-tag-queryreply: {{ default "yes" .log_tag_queryreply }}
    log-local-actions: {{ default "yes" .log_local_actions }}

    # Cache settings
    cache-min-ttl: {{ default "60" .cache_min_ttl }}
    cache-max-ttl: {{ default "86400" .cache_max_ttl }}
    msg-cache-size: {{ default "50m" .msg_cache_size }}
    rrset-cache-size: {{ default "100m" .rrset_cache_size }}

    # Security hardening
    hide-identity: {{ default "yes" .hide_identity }}
    hide-version: {{ default "yes" .hide_version }}
    harden-glue: {{ default "yes" .harden_glue }}
    harden-dnssec-stripped: {{ default "yes" .harden_dnssec_stripped }}
    use-caps-for-id: {{ default "yes" .use_caps_for_id }}
    harden-large-queries: {{ default "yes" .harden_large_queries }}
    harden-short-bufsize: {{ default "yes" .harden_short_bufsize }}

    # DNSSEC
    auto-trust-anchor-file: "{{ default "/var/lib/unbound/root.key" .trust_anchor_file }}"
    val-clean-additional: {{ default "yes" .val_clean_additional }}

    # Performance
    so-rcvbuf: {{ default "4m" .so_rcvbuf }}
    so-sndbuf: {{ default "4m" .so_sndbuf }}
    prefetch: {{ default "yes" .prefetch }}
    prefetch-key: {{ default "yes" .prefetch_key }}
    serve-expired: {{ default "yes" .serve_expired }}
    serve-expired-ttl: {{ default "86400" .serve_expired_ttl }}

    # Include drop-ins
    include: {{ default "/etc/unbound/unbound.conf.d/*.conf" .include_dir }}

# Remote control
remote-control:
    control-enable: {{ default "yes" .control_enable }}
    control-interface: {{ default "127.0.0.1" .control_interface }}
    control-port: {{ default "8953" .control_port }}

# Forward to upstream resolvers
forward-zone:
    name: "."
    {{ range .forwarders }}forward-addr: {{ . }}
    {{ else }}forward-addr: 8.8.8.8
    forward-addr: 8.8.4.4
    forward-addr: 1.1.1.1
    {{ end }}
