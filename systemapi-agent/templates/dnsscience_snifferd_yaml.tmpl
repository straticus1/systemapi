# DNS Science - DNS Sniffer Configuration
# Generated by systemapi-agent sysscript — {{ .generated_at }}

# ============================================================================
# REQUIRED SETTINGS
# ============================================================================

location_name: "{{ .location_name }}"
api_endpoint: "{{ default "https://dnsscience.io" .api_endpoint }}"
api_key: "{{ .api_key }}"
username: "{{ .username }}"

# ============================================================================
# NETWORK SETTINGS
# ============================================================================

# null = all interfaces; set to "eth0", "en0", etc. to pin to one
interface: {{ if .interface }}"{{ .interface }}"{{ else }}null{{ end }}

# ============================================================================
# FILTERING OPTIONS
# ============================================================================

filter_query_types: {{ if .filter_query_types }}{{ .filter_query_types | toYAMLList }}{{ else }}[]{{ end }}
filter_record_types: {{ if .filter_record_types }}{{ .filter_record_types | toYAMLList }}{{ else }}[]{{ end }}
filter_domains: {{ if .filter_domains }}{{ .filter_domains | toYAMLList }}{{ else }}[]{{ end }}

exclude_domains:
  {{ range .exclude_domains }}- "{{ . }}"
  {{ else }}- "local"
  - "localhost"
  - "in-addr.arpa"
  - "ip6.arpa"
  {{ end }}
# ============================================================================
# CACHING & PERFORMANCE
# ============================================================================

caching_enabled: {{ default "true" .caching_enabled }}
cache_ttl: {{ default "300" .cache_ttl }}
report_interval: {{ default "60" .report_interval }}
batch_size: {{ default "100" .batch_size }}

# ============================================================================
# MONITORING OPTIONS
# ============================================================================

monitor_responses: {{ default "true" .monitor_responses }}

# ============================================================================
# LOGGING
# ============================================================================

log_level: "{{ default "INFO" .log_level }}"
